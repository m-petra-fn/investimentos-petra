<configuration>
    <!-- DEFINA OS PATTERNS ANTES do include -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %clr(%5p) --- [%clr(%t){faint}] %clr(%-40.40logger{39}){cyan} :%replace(%X{x-fapi-interaction-id}){'^(.+)$',' %clr(xfid=){faint}%clr[x-fapi-tracing: $1]{green}'} %m%n%wEx"/>

    <!-- Inclui o base do Spring Boot (registra %clr e demais conversores) -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>